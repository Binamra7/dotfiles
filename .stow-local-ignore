# Files in the repo root that must NOT be symlinked into $HOME by `stow .`
# (stow treats each line as a Perl regex; no slash => matched against basename)

# Package manifests — documentation/backup, not configs. Covers the Arch
# (user_packages.list), Debian apt (apt_packages.list) and dpkg dump
# (packages.list) lists; the trailing pattern matches all three by basename.
.*packages\.list

# Claude Code project tooling — tracked in git, but lives in the repo, not $HOME
CLAUDE\.md
\.claude

# Repo metadata / generated artifacts — belong to the repo, not $HOME
README\.md
\.gitignore
\.ruby-lsp
\.git
