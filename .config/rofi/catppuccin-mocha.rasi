/*
 * Catppuccin Mocha — https://github.com/catppuccin/catppuccin
 * Palette roles are distinct so selection, borders and surfaces are visible.
 */
* {
    base:     #1e1e2e;   /* window / list background      */
    surface0: #313244;   /* raised surfaces (buttons, msg)*/
    surface1: #45475a;   /* selected element              */
    blue:     #89b4fa;   /* accent (prompt, border, tabs) */
    green:    #a6e3a1;   /* active state                  */
    red:      #f38ba8;   /* urgent state                  */
    fg-col:   #cdd6f4;   /* primary text                  */
    grey:     #6c7086;   /* muted text / placeholder      */

    width:   600px;
    font:    "JetBrainsMono Nerd Font 15";
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    width:            @width;
    height:           360px;
    border:           3px;
    border-color:     @blue;
    border-radius:    10px;
    background-color: @base;
}

mainbox {
    background-color: @base;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: @base;
    border-radius:    5px;
    padding:          2px;
}

prompt {
    background-color: @blue;
    text-color:       @base;
    padding:          6px;
    border-radius:    3px;
    margin:           20px 0px 0px 20px;
}

entry {
    background-color:  @base;
    text-color:        @fg-col;
    placeholder:       "Search…";
    placeholder-color: @grey;
    padding:           6px;
    margin:            20px 0px 0px 10px;
    cursor:            text;
}

listview {
    background-color: @base;
    columns:          2;
    lines:            5;
    border:           0px;
    padding:          6px 0px 0px;
    margin:           10px 0px 0px 20px;
    scrollbar:        false;
}

element {
    background-color: @base;
    text-color:       @fg-col;
    padding:          5px;
    border-radius:    3px;
    cursor:           pointer;
}

element-icon {
    size: 25px;
}

element selected {
    background-color: @surface1;
    text-color:       @fg-col;
}

element selected.urgent { background-color: @red;   text-color: @base; }
element selected.active { background-color: @green; text-color: @base; }
element urgent          { text-color: @red;   }
element active          { text-color: @green; }

mode-switcher {
    spacing: 5px;
}

button {
    background-color: @surface0;
    text-color:       @grey;
    padding:          10px;
    vertical-align:   0.5;
    horizontal-align: 0.5;
}

button selected {
    background-color: @base;
    text-color:       @blue;
}

message {
    background-color: @surface0;
    border-radius:    5px;
    margin:           2px;
    padding:          2px;
}

textbox {
    background-color: @surface0;
    text-color:       @blue;
    padding:          6px;
    margin:           20px 0px 0px 20px;
}
