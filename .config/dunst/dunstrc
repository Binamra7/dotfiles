[global]
    #### Position ####
    origin = top-right
    offset = 20x20

    ### Size ###
    width = 360
    height = 120
    notification_limit = 5

    ### Font ###
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"

    ### Spacing ###
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    separator_height = 2

    ### Appearance ###
    corner_radius = 10
    transparency = 10
    frame_color = "#89b4fa"
    separator_color = frame

    ### Icons ###
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 6

    ### Behavior ###
    idle_threshold = 120
    sticky_history = yes
    history_length = 20
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#6c7086"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 8

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#fab387"
    timeout = 0

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period
